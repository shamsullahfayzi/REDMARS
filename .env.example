# REDMARS — env template. COMMITTED. Copy to .env and fill real values:
#   cp .env.example .env
# .env is gitignored; this file documents which vars exist.

# --- Postgres (Docker container) ---
POSTGRES_USER=redmars
POSTGRES_PASSWORD=change-me
POSTGRES_DB=redmars

# Host port mapped to the container's 5432.
# 5433 avoids clashing with a Postgres already installed on the host (5432).
POSTGRES_PORT=5433

# Adminer web UI port (change if 8080 is taken on the host)
ADMINER_PORT=8081

# --- Backups (0.9) ---
# Cron expression, evaluated in TZ below (not UTC). Default: 2am local.
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14
TZ=Asia/Kabul

# --- Connection string (Prisma/Nest read this; wired in 0.3) ---
DATABASE_URL=postgresql://redmars:change-me@localhost:5433/redmars?schema=public
