# REDMARS — env template. COMMITTED. Copy to .env and fill real values:
#   cp .env.example .env
# .env is gitignored; this file documents which vars exist.

# --- Postgres (Docker container) ---
POSTGRES_USER=redmars
POSTGRES_PASSWORD=change-me
POSTGRES_DB=redmars

# Host port mapped to the container's 5432.
# 5433 avoids clashing with a Postgres already installed on the host (5432).
POSTGRES_PORT=5433

# Adminer web UI port (change if 8080 is taken on the host)
ADMINER_PORT=8081

# --- Caddy HTTPS front door (7.2) ---
# Standard HTTPS port. Change only if something else on the host already owns
# 443 (e.g. a local Apache/IIS) — see docs/https-lan.md.
CADDY_HTTPS_PORT=443
# Second Caddy port, fronting the API on its own origin (see Caddyfile for why).
CADDY_API_PORT=8443

# --- Backups (0.9) ---
# Cron expression, evaluated in TZ below (not UTC). Default: 2am local.
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14
TZ=Asia/Kabul

# --- Connection string (Prisma/Nest read this; wired in 0.3) ---
# connection_limit/pool_timeout set explicitly (task 7.7): Prisma's unstated default
# pool size (num_cpus*2+1) measured 9 on the dev box, and a 40-concurrent-patient load
# test exhausted it in seconds — every query past the 9th queued for a connection that
# never freed up in time, and the whole facility saw 500s at once. 20 leaves headroom
# under Postgres's own max_connections (100 by default) for adminer/backup alongside it.
DATABASE_URL=postgresql://redmars:change-me@localhost:5433/redmars?schema=public&connection_limit=20&pool_timeout=20

# --- Containerized install only (task 7.13, docker-compose.prod.yml) ---
# The origin a BROWSER reaches the API at — the front door's HTTPS port, never
# the internal `api:3000` container name. Vite bakes this into the web build
# at image-build time, so it must be set correctly BEFORE `pnpm deploy:up`.
VITE_API_URL=https://redmars.local:8443
