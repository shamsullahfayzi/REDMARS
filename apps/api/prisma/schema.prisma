  panel    Panel    @relation(fields: [panelId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@unique([facilityId, panelId, memberNo])
  @@unique([id, facilityId])
  @@index([patientId, status])
  @@map("patient_coverage")
}

model ReceptionPatientDeposit {
