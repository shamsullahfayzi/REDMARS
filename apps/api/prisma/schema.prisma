  status         String    @default("open")
  note           String
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([id, facilityId])
  @@index([facilityId, status, createdAt])
  @@map("reception_shift_handover")
}

/// 19 — who moved the visit to which status, and when. Medico-legal.
model VisitStatusHistory {
  id        String      @id @default(uuid())
  visitId   String      @map("visit_id")
  status    VisitStatus
  changedBy String?     @map("changed_by")
  changedAt DateTime    @default(now()) @map("changed_at")
  note      String?

  visit Visit @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("visit_status_history")
}

// ============================================================
// 6. CLINICAL RECORD
// ============================================================

/// 20 — BMI is DERIVED. Do not store it.
model Vitals {
  id           String   @id @default(uuid())
  visitId      String   @map("visit_id")
  systolicBp   Int?     @map("systolic_bp")
  diastolicBp  Int?     @map("diastolic_bp")
  pulse        Int?
  temperatureC Decimal? @map("temperature_c") @db.Decimal(4, 1)
  respiratory  Int?
  spo2         Int?
  weightKg     Decimal? @map("weight_kg") @db.Decimal(5, 2)
  heightCm     Decimal? @map("height_cm") @db.Decimal(5, 2)
  recordedBy   String?  @map("recorded_by")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  visit Visit @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("vitals")
}

/// 21 — WHO's international disease codes. F32.1 = moderate depressive episode.
/// Seed once (~70k rows, free from WHO). Doctors type text; the UI suggests the code.
model IcdCode {
  code       String  @id // "F32.1"
  title      String
  titleLocal String? @map("title_local")
  chapter    String?
  isBillable Boolean @default(true) @map("is_billable")

  diagnoses Diagnosis[]

  @@index([title])
  @@map("icd_code")
}

/// 22 — FHIR Condition. The doctor's conclusion.
model Diagnosis {
  id             String             @id @default(uuid())
  visitId        String             @map("visit_id")
  practitionerId String?            @map("practitioner_id")
  icdCode        String?            @map("icd_code")
  /// Free text ALWAYS allowed — they won't always find a code.
  text           String
  certainty      DiagnosisCertainty @default(provisional)
  isPrimary      Boolean            @default(false) @map("is_primary")
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at")

  visit        Visit         @relation(fields: [visitId], references: [id])
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id])
  icd          IcdCode?      @relation(fields: [icdCode], references: [code])

  @@index([visitId])
  @@map("diagnosis")
}

/// 23 — SOAP = Subjective / Objective / Assessment / Plan.
/// FOR AXON THIS IS THE MOST IMPORTANT CLINICAL TABLE: a psychiatric
/// assessment (mental state exam, risk assessment, history) is long-form and
/// shaped nothing like a surgical note. `content` is Json so each noteType
/// carries its own fields — this is the flexibility Mongo promised, inside Postgres.
model ClinicalNote {
  id             String   @id @default(uuid())
  visitId        String   @map("visit_id")
  practitionerId String?  @map("practitioner_id")
  noteType       String   @map("note_type") // soap | psych_assessment | mse | risk_assessment | progress
  content        Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  visit        Visit         @relation(fields: [visitId], references: [id])
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id])

  /// Task 4.13 — one note of each type per visit. A psychiatric assessment is written
  /// across a consultation and re-saved, so the write is a replace rather than an append,
  /// and this is what makes two saves racing produce a constraint error instead of two
  /// half-notes nobody can tell apart. The service still reads-then-writes rather than
  /// calling upsert: the audit extension covers create/update/delete and NOT upsert, and
  /// an unaudited psychiatric note is the one thing this table must never contain.
  @@unique([visitId, noteType])
  @@index([visitId])
  @@map("clinical_note")
}

/// 24
model Attachment {
  id         String   @id @default(uuid())
  visitId    String   @map("visit_id")
  fileName   String   @map("file_name")
  filePath   String   @map("file_path")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  visit Visit @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("attachment")
}

/// 25 — "Copy Last Prescription" + complaint/diagnosis/advice templates.
/// Keep this. Doctors will riot without it.
model Template {
  id             String   @id @default(uuid())
  facilityId     String   @map("facility_id")
  practitionerId String?  @map("practitioner_id") // null = shared across the hospital
  type           String // complaint | diagnosis | prescription | advice
  name           String
  content        Json
  createdAt      DateTime @default(now()) @map("created_at")

  facility Facility @relation(fields: [facilityId], references: [id])

  @@index([facilityId, type])
  @@map("template")
}

// ============================================================
// 7. DRUGS & PRESCRIPTIONS
// ============================================================

/// 26 — the FORMULARY. What you PRESCRIBE.
/// Deliberately separate from pharmacy stock (batches, quantities) — that's v2,
/// and keeping them apart is what lets the pharmacy module ship standalone later.
model Drug {
  id              String   @id @default(uuid())
  facilityId      String   @map("facility_id")
  code            String
  genericName     String   @map("generic_name")
  brandName       String?  @map("brand_name")
  atcCode         String?  @map("atc_code") // WHO ATC
  strength        String? // "20mg"
  form            String? // tablet | capsule | syrup | injection
  /// Defaults that autofill the prescription form. THIS is what makes it fast.
  defaultRoute    String?  @map("default_route")
  defaultFreq     String?  @map("default_freq") // OD | BD | TDS | QID | PRN
  defaultDuration String?  @map("default_duration")
  /// What the pharmacy charges for one unit, priced SERVER-side at dispense (task 6.10).
  /// Nullable: a drug with no price is dispensed at no charge (a sample, a free-issue item),
  /// which is a zero line, not a blocked one. The browser never sends this — the till reads
  /// it from here (guardrail 7).
  sellPrice       Decimal? @map("sell_price") @db.Decimal(12, 2)
  isControlled    Boolean  @default(false) @map("is_controlled")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility          Facility           @relation(fields: [facilityId], references: [id])
  prescriptionItems PrescriptionItem[]
  allergies         Allergy[]
  interactionsA     DrugInteraction[]  @relation("drugA")
  interactionsB     DrugInteraction[]  @relation("drugB")

  @@unique([facilityId, code])
  @@index([facilityId, genericName])
  @@map("drug")
}

/// 27 — drug A + drug B together = dangerous.
/// Highly relevant here: duloxetine + an MAOI = serotonin syndrome.
///
/// HONEST LIMIT: you cannot build a comprehensive interaction database — the real
/// ones are commercially licensed. Seed the 50–100 most dangerous psych interactions
/// and say so plainly in the UI. A half-complete checker that LOOKS complete is
/// worse than none, because it breeds false confidence.
model DrugInteraction {
  id          String @id @default(uuid())
  drugAId     String @map("drug_a_id")
  drugBId     String @map("drug_b_id")
  severity    String // minor | moderate | major | contraindicated
  description String

  drugA Drug @relation("drugA", fields: [drugAId], references: [id])
  drugB Drug @relation("drugB", fields: [drugBId], references: [id])

  @@unique([drugAId, drugBId])
  @@map("drug_interaction")
}

/// 28 — the clinical order. NO money here.
model Prescription {
  crmTasks             CrmTask[]
  version              Int         @default(1)
  id                   String      @id @default(uuid())
  visitId              String      @map("visit_id")
  practitionerId       String      @map("practitioner_id")
  status               OrderStatus @default(active)
  advice               String?
  /// Task 4.9 — why a flagged drug-drug interaction was prescribed anyway.
  /// One per sheet, not one per pair: an interaction is a fact about two MEDICINES, not
  /// about this patient, and the prescriber is saying "I know, and I meant it" about the
  /// combination as a whole. NULL means nothing needing acknowledgement was flagged.
  interactionAckReason String?     @map("interaction_ack_reason")
  followUpDate         DateTime?   @map("follow_up_date") @db.Date
  printedAt            DateTime?   @map("printed_at")
  /// When the pharmacy dispensed this sheet, and who did (task 6.10). Dispensing also moves
  /// status to `completed`, which takes it off the pharmacy queue; these record the event
  /// itself, for the daily till reconciliation (6.12).
  dispensedAt          DateTime?   @map("dispensed_at")
  dispensedBy          String?     @map("dispensed_by")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  visit             Visit              @relation(fields: [visitId], references: [id])
  practitioner      Practitioner       @relation(fields: [practitionerId], references: [id])
  items             PrescriptionItem[]
  followUpResponses FollowUpResponse[]

  @@index([visitId])
  @@map("prescription")
}

/// Durable, versioned module notifications. Written with the source transaction.
/// Consumers must process through IntegrationService so their local effects and
/// receipt commit together. Clinical text and credentials are excluded.
model IntegrationEvent {
  sequence      Int                  @unique @default(autoincrement())
  id            String               @id @default(uuid())
  facilityId    String               @map("facility_id")
  sourceAuditId String               @unique @map("source_audit_id")
  type          String
  version       Int                  @default(1)
  aggregateType String               @map("aggregate_type")
  aggregateId   String               @map("aggregate_id")
  payload       Json
  occurredAt    DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  facility      Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  receipts      IntegrationReceipt[]

  @@index([facilityId, occurredAt, id])
  @@map("integration_event")
}

/// One successful local delivery per named consumer. Failed transactions leave
/// no receipt and remain pending; one consumer cannot acknowledge another's work.
model IntegrationReceipt {
  eventId     String           @map("event_id")
  consumer    String
  processedAt DateTime         @default(now()) @map("processed_at") @db.Timestamptz(3)
  event       IntegrationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, consumer])
  @@map("integration_receipt")
}

model CommandReceipt {
  facilityId  String   @map("facility_id")
  userId      String   @map("user_id")
  operation   String
  key         String
  requestHash String   @map("request_hash")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([facilityId, userId, operation, key])
  @@map("command_receipt")
}

enum FollowUpResponseStatus {
  coming
  not_coming
  custom
}

/// The call center's log of "did we reach them, what did they say" — append-only (R4's
/// "nothing is ever hard-deleted" pattern), never overwritten. `followUpDate` is a SNAPSHOT
/// of the date being answered, not a live pointer: if a doctor reschedules the follow-up
/// after a call was logged, the old answer must not silently reattribute itself to the new
/// date. The "current" answer for a follow-up is simply the latest row for that
/// (prescriptionId, followUpDate) pair.
model FollowUpResponse {
  id             String                 @id @default(uuid())
  prescriptionId String                 @map("prescription_id")
  followUpDate   DateTime               @map("follow_up_date") @db.Date
  status         FollowUpResponseStatus
  note           String?
  recordedBy     String                 @map("recorded_by")
  recordedAt     DateTime               @default(now()) @map("recorded_at")

  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  recordedByUser AppUser      @relation(fields: [recordedBy], references: [id])

  @@index([prescriptionId, followUpDate])
  @@map("follow_up_response")
}

/// 29 — FHIR MedicationRequest.
/// dose + frequency + duration + route + quantity. All of them — your screenshot had them.
/// NO discount, NO total. Money lives on invoice_item.
model PrescriptionItem {
  id                    String   @id @default(uuid())
  prescriptionId        String   @map("prescription_id")
  drugId                String   @map("drug_id")
  /// Snapshot the name. If the formulary is edited in 2028, a 2026 prescription
  /// must still print what was ACTUALLY prescribed. Clinical records are
  /// historical documents — they are not retroactively rewritten by a lookup table.
  drugNameAtTime        String   @map("drug_name_at_time")
  dose                  String? // "1 tab"
  frequency             String // OD | BD | TDS
  duration              String // "1 month"
  route                 String // oral | IV | IM
  quantity              Int?
  instructions          String? // "after food"
  /// Task 4.8 — why this drug was prescribed to a patient recorded as allergic to it.
  /// NULL is the normal case and means there was no conflict. Non-null is medico-legal:
  /// the doctor was stopped, was shown the allergy, and said why they went ahead anyway.
  /// The override has to live on the RECORD and not only in the audit log, because the
  /// question "why was this prescribed?" is asked of the prescription, by people who are
  /// not reading audit tables.
  allergyOverrideReason String?  @map("allergy_override_reason")
  sequence              Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drug         Drug         @relation(fields: [drugId], references: [id])

  @@index([prescriptionId])
  @@map("prescription_item")
}

// ============================================================
// 8. LABORATORY
// ============================================================

/// 30 — the CATALOG. The master list of tests you offer. LOINC-coded.
model LabTest {
  id           String   @id @default(uuid())
  facilityId   String   @map("facility_id")
  code         String
  name         String
  // Dari (prs) and Pashto (ps) local names — see Facility. Both optional.
  nameLocalPrs String?  @map("name_local_prs")
  nameLocalPs  String?  @map("name_local_ps")
  loincCode    String?  @map("loinc_code")
  specimen     String? // blood | urine | csf
  unit         String? // mg/dL | %
  price        Decimal? @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  facility        Facility         @relation(fields: [facilityId], references: [id])
  panelTests      LabPanelTest[]
  orderItems      LabOrderItem[]
  referenceRanges ReferenceRange[]

  @@unique([facilityId, code])
  @@map("lab_test")
}

/// 31 — a BUNDLE. "Liver Function Test" = 5 tests.
/// The doctor clicks LFT once, not five times.
model LabPanel {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  code       String
  name       String
  price      Decimal? @db.Decimal(12, 2)
  isActive   Boolean  @default(true) @map("is_active")

  facility Facility       @relation(fields: [facilityId], references: [id])
  tests    LabPanelTest[]

  @@unique([facilityId, code])
  @@map("lab_panel")
}

/// 32
model LabPanelTest {
  panelId String @map("panel_id")
  testId  String @map("test_id")

  panel LabPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  test  LabTest  @relation(fields: [testId], references: [id])

  @@id([panelId, testId])
  @@map("lab_panel_test")
}

/// 33 — NORMAL VALUES. Haemoglobin normal is ~13–17 g/dL for men, ~12–15 for women.
/// The SAME number is normal for a woman and low for a man. This table is what
/// auto-flags the H/L on a result.
model ReferenceRange {
  id        String   @id @default(uuid())
  testId    String   @map("test_id")
  gender    Gender?
  minAge    Int?     @map("min_age")
  maxAge    Int?     @map("max_age")
  lowValue  Decimal? @map("low_value") @db.Decimal(12, 4)
  highValue Decimal? @map("high_value") @db.Decimal(12, 4)
  textValue String?  @map("text_value") // "Negative"

  test LabTest @relation(fields: [testId], references: [id])

  @@index([testId])
  @@map("reference_range")
}

/// 34 — FHIR ServiceRequest. The doctor's request.
model LabOrder {
  id             String      @id @default(uuid())
  facilityId     String      @map("facility_id")
  visitId        String      @map("visit_id")
  practitionerId String?     @map("practitioner_id")
  orderNo        String      @map("order_no")
  status         OrderStatus @default(active)
  clinicalNote   String?     @map("clinical_note") // why the test was ordered
  orderedAt      DateTime    @default(now()) @map("ordered_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  facility     Facility       @relation(fields: [facilityId], references: [id])
  visit        Visit          @relation(fields: [visitId, facilityId], references: [id, facilityId], onDelete: Restrict)
  practitioner Practitioner?  @relation(fields: [practitionerId, facilityId], references: [id, facilityId], onDelete: Restrict)
  items        LabOrderItem[]

  // The order number is issued per facility (the counter restarts at 1 in each), so it is
  // unique WITHIN a facility, not globally — the same rule invoiceNo follows. A bare @unique
  // on order_no would collide the moment a second facility placed its first order.
  @@unique([facilityId, orderNo])
  @@index([visitId])
  @@map("lab_order")
}

/// 35 — one test on the order. Carries its own status = the lab's state machine.
model LabOrderItem {
  id                String             @id @default(uuid())
  labOrderId        String             @map("lab_order_id")
  testId            String             @map("test_id")
  testNameAtTime    String             @map("test_name_at_time")
  status            LabOrderItemStatus @default(ordered)
  sampleCollectedAt DateTime?          @map("sample_collected_at")
  sampleCollectedBy String?            @map("sample_collected_by")

  labOrder LabOrder   @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  test     LabTest    @relation(fields: [testId], references: [id])
  result   LabResult?

  @@index([labOrderId])
  @@index([status])
  @@map("lab_order_item")
}

/// 36 — FHIR Observation. Flows back to the doctor via the visit.
model LabResult {
  referenceLow        Decimal?  @map("reference_low") @db.Decimal(12, 4)
  referenceHigh       Decimal?  @map("reference_high") @db.Decimal(12, 4)
  referenceText       String?   @map("reference_text")
  referenceCapturedAt DateTime? @map("reference_captured_at")
  id                  String    @id @default(uuid())
  labOrderItemId      String    @unique @map("lab_order_item_id")
  valueNumeric        Decimal?  @map("value_numeric") @db.Decimal(12, 4)
  valueText           String?   @map("value_text")
  unit                String?
  isAbnormal          Boolean   @default(false) @map("is_abnormal")
  flag                String? // H | L | HH | LL
  comment             String?
  enteredBy           String?   @map("entered_by")
  enteredAt           DateTime  @default(now()) @map("entered_at")
  verifiedBy          String?   @map("verified_by")
  verifiedAt          DateTime? @map("verified_at")

  labOrderItem LabOrderItem @relation(fields: [labOrderItemId], references: [id])

  @@map("lab_result")
}

// ============================================================
// 9. BILLING — deliberately minimal for v1
// ============================================================

/// 37 — consultation fees, card registration fee, procedures. Priced per department.
model Service {
  id           String  @id @default(uuid())
  facilityId   String  @map("facility_id")
  departmentId String  @map("department_id")
  code         String
  name         String
  fee          Decimal @db.Decimal(12, 2)
  isActive     Boolean @default(true) @map("is_active")

  facility   Facility   @relation(fields: [facilityId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([facilityId, code])
  @@map("service")
}

/// 38 — insurance / corporate / NGO payer. Straight off the Medi-Pro "Panel" field.
/// An employer or NGO pays instead of the patient.
/// ASK DR. HAFIZULLAH whether Axon actually has panels before you build the UI.
model Panel {
  id            String   @id @default(uuid())
  facilityId    String   @map("facility_id")
  code          String
  name          String
  contactPerson String?  @map("contact_person")
  phone         String?
  discountPct   Decimal? @map("discount_pct") @db.Decimal(5, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  facility         Facility          @relation(fields: [facilityId], references: [id])
  invoices         Invoice[]
  journals         FinanceJournal[]
  patientCoverages PatientCoverage[]

  @@unique([facilityId, code])
  @@unique([id, facilityId])
  @@map("panel")
}

/// 39 — ONE invoice table. Not APPOINTMENTPAYMENT + LABTESTPAYMENT + ...
model Invoice {
  id         String        @id @default(uuid())
  facilityId String        @map("facility_id")
  patientId  String        @map("patient_id")
  visitId    String?       @map("visit_id")
  panelId    String?       @map("panel_id") // set when an employer/NGO pays
  panelRefNo String?       @map("panel_ref_no")
  invoiceNo  String        @map("invoice_no")
  status     InvoiceStatus @default(draft)
  subtotal   Decimal       @default(0) @db.Decimal(12, 2)
  discount   Decimal       @default(0) @db.Decimal(12, 2)

  /// Why the price was reduced. Required whenever discount > 0 (task 3.6).
  /// A discount column with no reason column is how cash walks out of a till:
  /// the money is gone and the record says only that someone decided so.
  discountReason String? @map("discount_reason")

  /// Who authorised a discount above the receptionist's R10 ceiling, and when (task 6.5).
  /// A discount within the ceiling needs no approval and leaves these null; one past it
  /// carries the AppUser.id of the admin who approved it at the till — the second person
  /// the rule requires. Plain id, like createdBy, not a relation.
  discountApprovedBy String?   @map("discount_approved_by")
  discountApprovedAt DateTime? @map("discount_approved_at") @db.Timestamptz(3)

  total      Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  currency   String   @default("AFN")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy  String?  @map("created_by")

  facility          Facility                  @relation(fields: [facilityId], references: [id])
  patient           Patient                   @relation(fields: [patientId, facilityId], references: [id, facilityId], onDelete: Restrict)
  visit             Visit?                    @relation(fields: [visitId, facilityId], references: [id, facilityId], onDelete: Restrict)
  panel              Panel?                    @relation(fields: [panelId, facilityId], references: [id, facilityId], onUpdate: NoAction)
  journals          FinanceJournal[]
  financeState      FinanceInvoiceState?
  items             InvoiceItem[]
  payments          Payment[]
  receptionDeposits ReceptionPatientDeposit[]

  @@unique([facilityId, invoiceNo])
  @@unique([id, facilityId])
  @@index([patientId])
  @@map("invoice")
}

/// 40 — polymorphic line. refType says what refId points at.
/// This one table replaces the four payment tables in your original ERD.
model InvoiceItem {
  id          String    @id @default(uuid())
  invoiceId   String    @map("invoice_id")
  refType     String    @map("ref_type") // service | card_registration | lab_order_item | prescription_item
  refId       String?   @map("ref_id")
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal   @default(0) @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)
  // Per-LINE settlement. An invoice can hold several lab tests and a patient may pay for only
  // some of them, so paid-ness is tracked on the line, not just as one invoice total. The
  // bench draws the sample for a line once ITS charge is settled (a paid line, or a line that
  // cost nothing). Invoice.paidAmount stays the sum of paid lines, so the invoice total still
  // reconciles.
  isPaid      Boolean   @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_item")
}

/// 41 — an invoice can be paid in instalments. Append-only; reverse, never delete.
model Payment {
  id         String        @id @default(uuid())
  invoiceId  String        @map("invoice_id")
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  reference  String?
  receiptNo  String?       @map("receipt_no")
  receivedBy String?       @map("received_by")
  receivedAt DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  isReversed Boolean       @default(false) @map("is_reversed")

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payment")
}

// ============================================================
// 10. SYSTEM
// ============================================================

/// 42 — generates mrn, visit_no, invoice_no, order_no. Per facility, per year.
model NumberSequence {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  key        String // patient_mrn | visit_no | invoice_no | lab_order_no | receipt_no | finance_journal | employee_no | reception_request
  prefix     String?
  year       Int?
  current    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, key, year])
  @@map("number_sequence")
}

/// 43
model Setting {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  key        String
  value      Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, key])
  @@map("setting")
}

// ============================================================
// 11. LICENSING & MODULES
//
// Business model: monthly cash, per hospital, per enabled module.
//
// TWO HARD RULES, both learned the expensive way:
//  1. Expiry drives a BANNER/NAG. It NEVER blocks registration, consults,
//     prescriptions, or lab. A patient in the waiting room is never turned away
//     over a licensing dispute. Licensing pressure targets the ADMIN, not the patient.
//  2. The license is a SIGNED TOKEN (signed with your private key), checked
//     LOCALLY so no internet is required, and optionally bound to a hardware
//     fingerprint so the folder can't be copied to another clinic's PC and just run.
//     This is a speed bump + a dependency on you for updates/support — NOT a vault.
//     A determined technical copier with your server cannot be stopped; don't
//     pretend otherwise, and don't spend real time trying.
// ============================================================

/// 44 — one per facility. The signed agreement + the paid-through date.
model License {
  id                  String        @id @default(uuid())
  facilityId          String        @unique @map("facility_id")
  plan                String // e.g. "opd", "opd_lab", "full"
  status              LicenseStatus @default(active)
  /// The paid-through date. You flip this forward when cash is received. Manual — fine.
  paidThroughDate     DateTime      @map("paid_through_date") @db.Date
  /// Signed token (JWT-style, your private key). Server verifies locally, offline.
  signedToken         String?       @map("signed_token") @db.Text
  /// Hardware fingerprint the token is bound to (MAC/disk/CPU hash). Optional.
  hardwareFingerprint String?       @map("hardware_fingerprint")
  monthlyFee          Decimal?      @map("monthly_fee") @db.Decimal(12, 2)
  currency            String        @default("AFN")
  notes               String?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id])

  @@map("license")
}

/// 45 — which modules are turned on for this hospital.
/// nav hides disabled modules AND the ModuleGuard 403s their endpoints
/// (UI hiding is courtesy; the backend check is the control — same as RBAC).
model FacilityModule {
  facilityId String    @map("facility_id")
  module     ModuleKey
  enabled    Boolean   @default(false)
  enabledAt  DateTime? @map("enabled_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([facilityId, module])
  @@map("facility_module")
}

model PayrollConfig {
  facilityId String   @id @map("facility_id")
  taxName    String   @map("tax_name")
  taxBands   Json     @map("tax_bands")
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@map("payroll_config")
}

model PayrollEmployee {
  id           String            @id @default(uuid())
  facilityId   String            @map("facility_id")
  code         String
  name         String
  nameDari     String            @default("") @map("name_dari")
  basic        Decimal           @db.Decimal(18, 2)
  allowance    Decimal           @db.Decimal(18, 2)
  overtimeRate Decimal           @map("overtime_rate") @db.Decimal(18, 2)
  currency     String            @default("AFN")
  costCentreId String            @map("cost_centre_id")
  startsOn     DateTime          @map("starts_on") @db.Timestamptz(3)
  endsOn       DateTime?         @map("ends_on") @db.Timestamptz(3)
  isActive     Boolean           @default(true) @map("is_active")
  facility     Facility          @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  costCentre   FinanceCostCentre @relation(fields: [costCentreId, facilityId], references: [id, facilityId], onDelete: Restrict)
  items        PayrollItem[]
  loans        PayrollLoan[]

  @@unique([id, facilityId])
  @@unique([facilityId, code])
  @@map("payroll_employee")
}

model PayrollRun {
  id         String          @id @default(uuid())
  facilityId String          @map("facility_id")
  periodId   String          @map("period_id")
  date       DateTime        @db.Timestamptz(3)
  status     String          @default("calculated")
  version    Int             @default(1)
  createdBy  String          @map("created_by")
  reviewedBy String?         @map("reviewed_by")
  approvedBy String?         @map("approved_by")
  approvedAt DateTime?       @map("approved_at") @db.Timestamptz(3)
  taxName    String          @map("tax_name")
  taxBands   Json            @map("tax_bands")
  journalId  String?         @unique @map("journal_id")
  facility   Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  period     FiscalPeriod    @relation(fields: [periodId, facilityId], references: [id, facilityId], onDelete: Restrict)
  journal    FinanceJournal? @relation(fields: [journalId, facilityId], references: [id, facilityId], onDelete: Restrict)
  items      PayrollItem[]

  @@unique([id, facilityId])
  @@unique([facilityId, periodId])
  @@unique([journalId, facilityId])
  @@map("payroll_run")
  app_user_payroll_run_approved_by_facility_idToapp_user AppUser?        @relation("payroll_run_approved_by_facility_idToapp_user", fields: [approvedBy, facilityId], references: [id, facilityId], onDelete: NoAction, onUpdate: NoAction)
  app_user_payroll_run_created_by_facility_idToapp_user  AppUser         @relation("payroll_run_created_by_facility_idToapp_user", fields: [createdBy, facilityId], references: [id, facilityId], onDelete: NoAction, onUpdate: NoAction)
  app_user_payroll_run_reviewed_by_facility_idToapp_user AppUser?        @relation("payroll_run_reviewed_by_facility_idToapp_user", fields: [reviewedBy, facilityId], references: [id, facilityId], onDelete: NoAction, onUpdate: NoAction)
}

model PayrollItem {
  id             String             @id @default(uuid())
  facilityId     String             @map("facility_id")
  runId          String             @map("run_id")
  employeeId     String             @map("employee_id")
  costCentreId   String             @map("cost_centre_id")
  snapshot       Json
  gross          Decimal            @db.Decimal(18, 2)
  tax            Decimal            @db.Decimal(18, 2)
  loanDeduction  Decimal            @map("loan_deduction") @db.Decimal(18, 2)
  otherDeduction Decimal            @map("other_deduction") @db.Decimal(18, 2)
  net            Decimal            @db.Decimal(18, 2)
  facility       Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  run            PayrollRun         @relation(fields: [runId, facilityId], references: [id, facilityId], onDelete: Restrict)
  employee       PayrollEmployee    @relation(fields: [employeeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  costCentre     FinanceCostCentre  @relation(fields: [costCentreId, facilityId], references: [id, facilityId], onDelete: Restrict)
  repayments     PayrollRepayment[]
  payments       PayrollPayment[]

  @@unique([id, facilityId])
  @@unique([runId, employeeId])
  @@map("payroll_item")
}

model PayrollLoan {
  id            String             @id @default(uuid())
  facilityId    String             @map("facility_id")
  employeeId    String             @map("employee_id")
  kind          String
  reference     String
  amount        Decimal            @db.Decimal(18, 2)
  installment   Decimal            @db.Decimal(18, 2)
  firstPeriodId String             @map("first_period_id")
  journalId     String             @unique @map("journal_id")
  facility      Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  employee      PayrollEmployee    @relation(fields: [employeeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  firstPeriod   FiscalPeriod       @relation(fields: [firstPeriodId, facilityId], references: [id, facilityId], onDelete: Restrict)
  journal       FinanceJournal     @relation(fields: [journalId, facilityId], references: [id, facilityId], onDelete: Restrict)
  repayments    PayrollRepayment[]

  @@unique([id, facilityId])
  @@unique([facilityId, reference])
  @@unique([journalId, facilityId])
  @@map("payroll_loan")
}

model PayrollRepayment {
  id         String      @id @default(uuid())
  facilityId String      @map("facility_id")
  loanId     String      @map("loan_id")
  itemId     String      @map("item_id")
  amount     Decimal     @db.Decimal(18, 2)
  facility   Facility    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  loan       PayrollLoan @relation(fields: [loanId, facilityId], references: [id, facilityId], onDelete: Restrict)
  item       PayrollItem @relation(fields: [itemId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@unique([loanId, itemId])
  @@map("payroll_repayment")
}

model PayrollPayment {
  id         String         @id @default(uuid())
  facilityId String         @map("facility_id")
  itemId     String         @map("item_id")
  journalId  String         @unique @map("journal_id")
  amount     Decimal        @db.Decimal(18, 2)
  reference  String
  facility   Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  item       PayrollItem    @relation(fields: [itemId, facilityId], references: [id, facilityId], onDelete: Restrict)
  journal    FinanceJournal @relation(fields: [journalId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@unique([facilityId, reference])
  @@unique([journalId, facilityId])
  @@map("payroll_payment")
}

model FinanceAsset {
  id            String              @id @default(uuid())
  facilityId    String              @map("facility_id")
  code          String
  name          String
  category      String
  location      String
  cost          Decimal             @db.Decimal(18, 2)
  residual      Decimal             @db.Decimal(18, 2)
  lifeMonths    Int                 @map("life_months")
  acquiredOn    DateTime            @map("acquired_on") @db.Timestamptz(3)
  startPeriodId String              @map("start_period_id")
  costCentreId  String?             @map("cost_centre_id")
  billLineId    String?             @map("bill_line_id")
  createdBy     String              @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  facility      Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  startPeriod   FiscalPeriod        @relation(fields: [startPeriodId, facilityId], references: [id, facilityId], onDelete: Restrict)
  costCentre    FinanceCostCentre?  @relation(fields: [costCentreId, facilityId], references: [id, facilityId], onDelete: Restrict)
  billLine      FinanceJournalLine? @relation(fields: [billLineId, facilityId], references: [id, facilityId], onDelete: Restrict)
