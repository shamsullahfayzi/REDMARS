// ============================================================
// HMIS — v1 OPD core schema  (rev 2)
// Postgres + Prisma. Multi-tenant by facility_id, one DB per hospital.
//
// CHANGES IN REV 2 (from Shamo's review + the Medi-Pro/Zoya screenshot):
//  - DROPPED  Complaint table  → Visit.chiefComplaint is enough. Shamo was right.
//  - FIXED    Practitioner.departmentId → PractitionerDepartment (a doctor does OPD *and* IPD)
//  - ADDED    age in years/months/days (infants — Medi-Pro had this and it matters)
//  - ADDED    guardian name + relation (S/o, D/o, W/o)
//  - ADDED    Panel (insurance / corporate / NGO payer) + Invoice.panelId
//  - ADDED    referral tracking on Visit
//  - ADDED    demographic fields Medi-Pro carried (occupation, nationality, passport)
//
// Table count: 45
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Gender {
  male
  female
  other
  unknown
}

/// FHIR Encounter.status.
/// arrived      = checked in, sitting in the waiting room  ← THIS is your queue
/// in_progress  = the doctor has called them in and is seeing them now
/// The gap between the two is how you measure waiting time.
enum VisitStatus {
  planned
  arrived
  in_progress
  on_hold
  completed
  cancelled
  entered_in_error
}

/// Absorbs walk-ins without special-casing anything.
/// A walk-in HbA1c = type walk_in_lab, practitionerId null, appointmentId null.
enum VisitType {
  opd_consult
  follow_up
  walk_in_lab
  walk_in_pharmacy
  emergency
  ipd
}

enum AppointmentStatus {
  booked
  arrived
  fulfilled
  cancelled
  no_show
}

enum DepartmentType {
  opd
  ipd
  emergency
  laboratory
  pharmacy
  radiology
  administration
}

/// S/o, D/o, W/o — straight off the Medi-Pro form.
enum GuardianRelation {
  son_of
  daughter_of
  wife_of
  husband_of
  father_of
  mother_of
  other
}

enum OrderStatus {
  draft
  active
  on_hold
  completed
  cancelled
  entered_in_error
}

enum LabOrderItemStatus {
  ordered
  sample_collected
  in_progress
  resulted
  verified
  cancelled
}

enum DiagnosisCertainty {
  provisional
  differential
  confirmed
  refuted
}

enum AllergySeverity {
  mild
  moderate
  severe
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  cancelled
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  mobile_money
  panel
  waiver
}

enum AuditAction {
  create
  update
  delete
  read
  login
  logout
  failed_login
  print
  export
}

/// Toggleable modules. OPD is the core and is never toggleable — the system IS OPD.
enum ModuleKey {
  lab
  pharmacy
  ipd
  emergency
  radiology
  billing
  reports
  finance
  crm
  hr
}

enum HrSex {
  male
  female
  other
  undisclosed
}

enum EmploymentType {
  permanent
  fixed_term
  part_time
  temporary
  volunteer
}

enum EmployeeStatus {
  active
  on_leave
  suspended
  exited
}

enum EmployeeDocumentType {
  identity
  contract
  education
  license
  training
  disciplinary
  other
}

enum CredentialType {
  professional_license
  education
  certification
  training
  work_permit
  other
}

enum AttendanceStatus {
  present
  absent
  late
  on_leave
  holiday
  rest_day
}

enum LeaveRequestStatus {
  submitted
  approved
  rejected
  cancelled
}

enum RosterStatus {
  draft
  confirmed
  cancelled
}

/// Shared transient request counters. Keys are hashes of facility/user/scope;
/// no patient data or credentials. Updated atomically outside business auditing.
model RateLimitBucket {
  key       String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  count     Int

  @@index([expiresAt])
  @@map("rate_limit_bucket")
}

/// License states. Note: expiry NEVER blocks a clinical action — it drives a
/// banner/nag only. See build order Phase 7 and the ModuleGuard note.
enum LicenseStatus {
  active
  expiring_soon
  past_due
  suspended
}

/// Why a session was ended (task 1.8). Drives the message the ended device sees:
/// `superseded` is "you signed in elsewhere", `logout` is "you signed out here",
/// `deactivated` is "your account was disabled". Absent while a session is live.
enum SessionRevokeReason {
  logout
  superseded
  deactivated
}

// ============================================================
// 1. TENANCY & ORGANISATION
// ============================================================

/// 1
model Facility {
  hrPositions         Position[]
  employees           Employee[]
  employeeDocuments   EmployeeDocument[]
  employeeCredentials Credential[]
  credentialReminders CredentialReminder[]
  attendanceDays      AttendanceDay[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  hrHolidays          HrHoliday[]
  shiftTypes          ShiftType[]
  rosterEntries       RosterEntry[]
  hrNotifications     HrNotification[]
  crmInteractions     CrmInteraction[]
  crmLeads            CrmLead[]
  crmContacts         CrmContact[]
  reportGrants        FinanceReportGrant[]
  reportTemplates     FinanceReportTemplate[]
  cashClassifications FinanceCashClassification[]
  periodEvents        FinancePeriodEvent[]
  yearClosings        FinanceYearClosing[]
  assets              FinanceAsset[]
  assetEntries        FinanceAssetEntry[]
  budgets             FinanceBudget[]
  payrollConfig       PayrollConfig?
  payrollEmployees    PayrollEmployee[]
  payrollRuns         PayrollRun[]
  payrollItems        PayrollItem[]
  payrollLoans        PayrollLoan[]
  payrollRepayments   PayrollRepayment[]
  payrollPayments     PayrollPayment[]
  id                  String                      @id @default(uuid())
  code                String                      @unique
  name                String
  // Two local names, not one: Axon's region reads Dari (prs) and Pashto (ps),
  // and a single column forces a choice the hospital should not have to make.
  // Both optional — fill what you have. Column suffixes match the app's i18n
  // locale codes (prs/ps) so the wire, the DB, and the UI all speak one vocabulary.
  nameLocalPrs        String?                     @map("name_local_prs")
  nameLocalPs         String?                     @map("name_local_ps")
  address             String?
  phone               String?
  // Printed at the foot of the invoice when set (task: Axon field changes). Optional —
  // a hospital without an email address simply prints no footer line for it.
  email               String?
  logoPath            String?                     @map("logo_path")
  timezone            String                      @default("Asia/Kabul")
  currency            String                      @default("AFN")
  isActive            Boolean                     @default(true) @map("is_active")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  departments           Department[]
  rooms                 Room[]
  users                 AppUser[]
  practitioners         Practitioner[]
  patients              Patient[]
  visits                Visit[]
  appointments          Appointment[]
  drugs                 Drug[]
  labTests              LabTest[]
  labPanels             LabPanel[]
  services              Service[]
  invoices              Invoice[]
  labOrders             LabOrder[]
  panels                Panel[]
  auditLogs             AuditLog[]
  errorLogs             ErrorLog[]
  numberSequences       NumberSequence[]
  settings              Setting[]
  templates             Template[]
  license               License?
  modules               FacilityModule[]
  integrationEvents     IntegrationEvent[]
  commandReceipts       CommandReceipt[]
  financeSettings       FinanceSettings?
  financeAccounts       FinanceAccount[]
  financePeriods        FiscalPeriod[]
  fiscalYears           FiscalYear[]
  legacyFinancePeriods  FinanceLegacyPeriod[]
  financeJournals       FinanceJournal[]
  financeSuppliers      FinanceSupplier[]
  financeBills          FinanceBill[]
  financeSettlements    FinanceSettlement[]
  financeStatements     FinanceStatement[]
  financeAudits         FinanceAudit[]
  revenueMappings       FinanceRevenueMapping[]
  tillCloses            FinanceTillClose[]
  financeDeposits       FinanceDeposit[]
  invoiceFinanceStates  FinanceInvoiceState[]
  costCentres           FinanceCostCentre[]
  expenseMappings       FinanceExpenseMapping[]
  procurementReceipts   FinanceProcurementReceipt[]
  receptionBeds         ReceptionBed[]
  receptionCareRequests ReceptionCareRequest[]
  appointmentWaitlist   AppointmentWaitlist[]
  patientDocuments      PatientDocument[]
  patientContacts       PatientContact[]
  patientCoverages      PatientCoverage[]
  patientDeposits       ReceptionPatientDeposit[]
  receptionReminders    ReceptionReminder[]
  receptionHandovers    ReceptionShiftHandover[]

  @@map("facility")
}

// Finance owns its ledger. Clinical and billing records remain their source data.
enum FinanceAccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum FinanceJournalStatus {
  draft
  posted
}

model FinanceSettings {
  facilityId  String   @id @map("facility_id")
  currency    String   @default("AFN")
  cutoverDate DateTime @map("cutover_date") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@map("finance_settings")
}

model FinanceAccount {
  budgets         FinanceBudget[]
  id              String                  @id @default(uuid())
  facilityId      String                  @map("facility_id")
  code            String
  name            String
  type            FinanceAccountType
  parentId        String?                 @map("parent_id")
  normalBalance   String                  @default(dbgenerated()) @map("normal_balance")
  isPosting       Boolean                 @default(true) @map("is_posting")
  parent              FinanceAccount?         @relation("AccountHierarchy", fields: [parentId, facilityId], references: [id, facilityId], onUpdate: NoAction, map: "account_parent_facility")
  children        FinanceAccount[]        @relation("AccountHierarchy")
  revenueMappings FinanceRevenueMapping[]
  expenseMappings FinanceExpenseMapping[]
  systemKey       String?                 @map("system_key")
  isControl       Boolean                 @default(false) @map("is_control")
  isCash          Boolean                 @default(false) @map("is_cash")
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  facility        Facility                @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  lines           FinanceJournalLine[]
  statements      FinanceStatement[]

  @@unique([facilityId, code])
  @@unique([facilityId, systemKey])
  @@unique([id, facilityId])
  @@map("finance_account")
  finance_asset_entry FinanceAssetEntry[]
}

model FiscalYear {
  closing    FinanceYearClosing?
  id         String              @id @default(uuid())
  facilityId String              @map("facility_id")
  year       Int
  label      String
  startsOn   DateTime            @map("starts_on") @db.Timestamptz(3)
  endsOn     DateTime            @map("ends_on") @db.Timestamptz(3)
  facility   Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  periods    FiscalPeriod[]

  @@unique([facilityId, year])
  @@unique([id, facilityId])
  @@map("fiscal_year")
}

/// Read-only archive of pre-Shamsi periods; closed ranges remain posting restrictions.
model FinanceLegacyPeriod {
  id         String           @id
  facilityId String           @map("facility_id")
  name       String
  startsOn   DateTime         @map("starts_on") @db.Timestamptz(3)
  endsOn     DateTime         @map("ends_on") @db.Timestamptz(3)
  closedAt   DateTime?        @map("closed_at") @db.Timestamptz(3)
  closedBy   String?          @map("closed_by")
  closer     AppUser?         @relation("LegacyPeriodCloser", fields: [closedBy, facilityId], references: [id, facilityId], onDelete: Restrict)
  facility   Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  journals   FinanceJournal[]

  @@unique([id, facilityId])
  @@map("finance_legacy_period")
}

model FiscalPeriod {
  lockedAt       DateTime?            @map("locked_at") @db.Timestamptz(3)
  lockedBy       String?              @map("locked_by")
  closeEvents    FinancePeriodEvent[]
  startingAssets FinanceAsset[]
  assetEntries   FinanceAssetEntry[]
  budgets        FinanceBudget[]
  payrollRuns    PayrollRun[]
  payrollLoans   PayrollLoan[]
  yearId         String               @map("year_id")
  month          Int
  label          String
  fiscalYear     FiscalYear           @relation(fields: [yearId, facilityId], references: [id, facilityId], onDelete: Restrict)
  id             String               @id @default(uuid())
  facilityId     String               @map("facility_id")
  name           String
  startsOn       DateTime             @map("starts_on") @db.Timestamptz(3)
  endsOn         DateTime             @map("ends_on") @db.Timestamptz(3)
  closedAt       DateTime?            @map("closed_at") @db.Timestamptz(3)
  closedBy       String?              @map("closed_by")
  closer         AppUser?             @relation("FiscalPeriodCloser", fields: [closedBy, facilityId], references: [id, facilityId], onDelete: Restrict)
  facility       Facility             @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  journals       FinanceJournal[]

  @@unique([facilityId, name])
  @@unique([id, facilityId])
  @@unique([yearId, month])
  @@unique([facilityId, label])
  @@index([facilityId, startsOn, endsOn])
  @@map("finance_period")
  app_user_finance_period_locked_by_facility_idToapp_user AppUser?             @relation("finance_period_locked_by_facility_idToapp_user", fields: [lockedBy, facilityId], references: [id, facilityId], onDelete: NoAction, onUpdate: NoAction, map: "period_lock_actor")
}

model FinanceJournal {
  cashClassification FinanceCashClassification?
  yearClosing        FinanceYearClosing?
  assetEntry         FinanceAssetEntry?
  payrollRun         PayrollRun?
  payrollLoan        PayrollLoan?
  payrollPayment     PayrollPayment?
  id                 String                     @id @default(uuid())
  facilityId         String                     @map("facility_id")
  periodId           String                     @map("period_id")
  legacyPeriodId     String?                    @map("legacy_period_id")
  legacyPeriod       FinanceLegacyPeriod?       @relation(fields: [legacyPeriodId, facilityId], references: [id, facilityId], onDelete: Restrict)
  number             String?
  date               DateTime                   @db.Timestamptz(3)
  currency           String                     @default("AFN")
  memo               String
  status             FinanceJournalStatus       @default(draft)
  sourceType         String                     @default("manual") @map("source_type")
  sourceId           String?                    @map("source_id")
  invoiceId          String?                    @map("invoice_id")
  paymentId          String?                    @map("payment_id")
  panelId            String?                    @map("panel_id")
  invoice            Invoice?                   @relation(fields: [invoiceId, facilityId], references: [id, facilityId], onUpdate: NoAction, map: "finance_journal_invoice_fk")
  panel              Panel?                     @relation(fields: [panelId, facilityId], references: [id, facilityId], onUpdate: NoAction, map: "finance_journal_panel_fk")
  deposit            FinanceDeposit?
  reversalOfId       String?                    @unique @map("reversal_of_id")
  version            Int                        @default(1)
  createdBy          String                     @map("created_by")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  postedBy           String?                    @map("posted_by")
  postedAt           DateTime?                  @map("posted_at") @db.Timestamptz(3)
  creator            AppUser                    @relation("JournalCreator", fields: [createdBy, facilityId], references: [id, facilityId], onDelete: Restrict)
  poster             AppUser?                   @relation("JournalPoster", fields: [postedBy, facilityId], references: [id, facilityId], onDelete: Restrict)
  facility           Facility                   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  period             FiscalPeriod               @relation(fields: [periodId, facilityId], references: [id, facilityId], onDelete: Restrict)
  reversalOf         FinanceJournal?            @relation("FinanceReversal", fields: [reversalOfId, facilityId], references: [id, facilityId], onDelete: Restrict)
  reversal           FinanceJournal?            @relation("FinanceReversal")
  lines              FinanceJournalLine[]
  bill               FinanceBill?
  settlements        FinanceSettlement[]

  @@unique([reversalOfId, facilityId])
  @@unique([facilityId, number])
  @@unique([facilityId, sourceType, sourceId])
  @@unique([id, facilityId])
  @@index([facilityId, date, status])
  @@map("finance_journal")
}

model FinanceJournalLine {
  capitalizedAssets FinanceAsset[]
  id                String                @id @default(uuid())
  facilityId        String                @map("facility_id")
  journalId         String                @map("journal_id")
  accountId         String                @map("account_id")
  description       String                @default("")
  costCentreId      String?               @map("cost_centre_id")
  costCentre        FinanceCostCentre?    @relation(fields: [costCentreId, facilityId], references: [id, facilityId], onUpdate: NoAction, map: "finance_line_centre_fk")
  debit             Decimal               @default(0) @db.Decimal(18, 2)
  credit            Decimal               @default(0) @db.Decimal(18, 2)
  currency          String                @default("AFN")
  exchangeRate      Decimal               @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  baseDebit         Decimal               @default(dbgenerated()) @map("base_debit") @db.Decimal(18, 2)
  baseCredit        Decimal               @default(dbgenerated()) @map("base_credit") @db.Decimal(18, 2)
  journal           FinanceJournal        @relation(fields: [journalId, facilityId], references: [id, facilityId], onDelete: Restrict)
  account           FinanceAccount        @relation(fields: [accountId, facilityId], references: [id, facilityId], onDelete: Restrict)
  statementLine     FinanceStatementLine?

  @@unique([id, facilityId])
  @@index([facilityId, accountId])
  @@map("finance_journal_line")
}

model FinanceAudit {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  facilityId String   @map("facility_id")
  journalId  String?  @map("journal_id")
  actorId    String?  @map("actor_id")
  occurredAt DateTime @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(3)
  action     String
  entity     String
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  facility   Facility @relation(fields: [facilityId], references: [id], onUpdate: NoAction)

  @@index([facilityId, journalId, occurredAt])
  @@map("finance_audit")
}

model FinanceRevenueMapping {
  id         String         @id @default(uuid())
  facilityId String         @map("facility_id")
  category   String
  accountId  String         @map("account_id")
  facility   Facility       @relation(fields: [facilityId], references: [id], onUpdate: NoAction)
  account    FinanceAccount @relation(fields: [accountId, facilityId], references: [id, facilityId], onUpdate: NoAction, map: "finance_mapping_account_fk")

  @@unique([facilityId, category])
  @@map("finance_revenue_mapping")
}

model FinanceInvoiceState {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  invoiceId  String   @unique @map("invoice_id")
  target     Json
  facility   Facility @relation(fields: [facilityId], references: [id], onUpdate: NoAction)
  invoice    Invoice  @relation(fields: [invoiceId, facilityId], references: [id, facilityId], onUpdate: NoAction)

  @@unique([invoiceId, facilityId])
  @@map("finance_invoice_state")
}

model FinanceTillClose {
  id         String           @id @default(uuid())
  facilityId String           @map("facility_id")
  userId     String           @map("user_id")
  origin     String
  label      String
  startsAt   DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime         @map("ends_at") @db.Timestamptz(3)
  opening    Decimal          @db.Decimal(18, 2)
  expected   Decimal          @db.Decimal(18, 2)
  counted    Decimal          @db.Decimal(18, 2)
  difference Decimal          @db.Decimal(18, 2)
  paymentIds Json             @map("payment_ids")
  note       String
  createdBy  String           @map("created_by")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedBy String?          @map("approved_by")
  approvedAt DateTime?        @map("approved_at") @db.Timestamptz(3)
  facility                                                      Facility         @relation(fields: [facilityId], references: [id], onUpdate: NoAction)
  deposits   FinanceDeposit[]

  @@unique([id, facilityId])
  @@index([facilityId, userId, startsAt])
  @@map("finance_till_close")
  app_user_finance_till_close_approved_by_facility_idToapp_user AppUser?         @relation("finance_till_close_approved_by_facility_idToapp_user", fields: [approvedBy, facilityId], references: [id, facilityId], onUpdate: NoAction)
  app_user_finance_till_close_created_by_facility_idToapp_user  AppUser          @relation("finance_till_close_created_by_facility_idToapp_user", fields: [createdBy, facilityId], references: [id, facilityId], onUpdate: NoAction)
  app_user_finance_till_close_user_id_facility_idToapp_user     AppUser          @relation("finance_till_close_user_id_facility_idToapp_user", fields: [userId, facilityId], references: [id, facilityId], onUpdate: NoAction)
}

model FinanceDeposit {
  id          String            @id @default(uuid())
  facilityId  String            @map("facility_id")
  journalId   String            @unique @map("journal_id")
  tillCloseId String?           @map("till_close_id")
  reference   String
  amount      Decimal           @db.Decimal(18, 2)
  facility    Facility          @relation(fields: [facilityId], references: [id], onUpdate: NoAction)
  journal     FinanceJournal    @relation(fields: [journalId, facilityId], references: [id, facilityId], onUpdate: NoAction)
  tillClose   FinanceTillClose? @relation(fields: [tillCloseId, facilityId], references: [id, facilityId], onUpdate: NoAction)

  @@unique([journalId, facilityId])
  @@unique([facilityId, reference])
  @@map("finance_deposit")
}

model FinanceSupplier {
  id                  String                      @id @default(uuid())
  facilityId          String                      @map("facility_id")
  name                String
  reference           String?
  termsDays           Int                         @default(0) @map("terms_days")
  terms               String                      @default("")
  contact             String                      @default("")
  isActive            Boolean                     @default(true) @map("is_active")
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  facility            Facility                    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  bills               FinanceBill[]
  procurementReceipts FinanceProcurementReceipt[]

  @@unique([id, facilityId])
  @@unique([facilityId, name])
  @@map("finance_supplier")
}

model FinanceBill {
  id          String                     @id @default(uuid())
  facilityId  String                     @map("facility_id")
  supplierId  String                     @map("supplier_id")
  reference   String
  kind        String                     @default("bill")
  receiptId   String?                    @unique @map("receipt_id")
  receipt     FinanceProcurementReceipt? @relation(fields: [receiptId, facilityId], references: [id, facilityId], onUpdate: NoAction, map: "finance_bill_receipt_fk")
  dueOn       DateTime                   @map("due_on") @db.Timestamptz(3)
  amount      Decimal                    @db.Decimal(18, 2)
  journalId   String                     @unique @map("journal_id")
  facility    Facility                   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  supplier    FinanceSupplier            @relation(fields: [supplierId, facilityId], references: [id, facilityId], onDelete: Restrict)
  journal     FinanceJournal             @relation(fields: [journalId, facilityId], references: [id, facilityId], onDelete: Restrict)
  settlements FinanceSettlement[]

  @@unique([journalId, facilityId])
  @@unique([facilityId, supplierId, reference])
  @@unique([receiptId, facilityId])
  @@unique([id, facilityId])
  @@map("finance_bill")
}

model FinanceSettlement {
  id         String         @id @default(uuid())
  facilityId String         @map("facility_id")
  billId     String         @map("bill_id")
  amount     Decimal        @db.Decimal(18, 2)
  journalId  String         @map("journal_id")
  facility   Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  bill       FinanceBill    @relation(fields: [billId, facilityId], references: [id, facilityId], onDelete: Restrict)
  journal    FinanceJournal @relation(fields: [journalId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@unique([journalId, billId])
  @@map("finance_settlement")
}

model FinanceCostCentre {
  assets           FinanceAsset[]
  budgets          FinanceBudget[]
  payrollEmployees PayrollEmployee[]
  payrollItems     PayrollItem[]
  id               String                  @id @default(uuid())
  facilityId       String                  @map("facility_id")
  code             String
  name             String
  isActive         Boolean                 @default(true) @map("is_active")
  facility         Facility                @relation(fields: [facilityId], references: [id], onUpdate: NoAction)
  lines            FinanceJournalLine[]
  mappings         FinanceExpenseMapping[]

  @@unique([id, facilityId])
  @@unique([facilityId, code])
  @@map("finance_cost_centre")
}

model FinanceExpenseMapping {
  id           String             @id @default(uuid())
  facilityId   String             @map("facility_id")
  category     String
  accountId    String             @map("account_id")
  costCentreId String?            @map("cost_centre_id")
  facility     Facility           @relation(fields: [facilityId], references: [id], onUpdate: NoAction)
  account      FinanceAccount     @relation(fields: [accountId, facilityId], references: [id, facilityId], onUpdate: NoAction)
  costCentre   FinanceCostCentre? @relation(fields: [costCentreId, facilityId], references: [id, facilityId], onUpdate: NoAction)

  @@unique([facilityId, category])
  @@map("finance_expense_mapping")
}

// Immutable output consumed from procurement; purchase orders and stock remain upstream.
model FinanceProcurementReceipt {
  id           String          @id @default(uuid())
  facilityId   String          @map("facility_id")
  supplierId   String          @map("supplier_id")
  sourceSystem String          @map("source_system")
  poReference  String          @map("po_reference")
  grnReference String          @map("grn_reference")
  receivedOn   DateTime        @map("received_on") @db.Timestamptz(3)
  lines        Json
  amount       Decimal         @db.Decimal(18, 2)
  createdBy    String          @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  facility     Facility        @relation(fields: [facilityId], references: [id], onUpdate: NoAction)
  supplier     FinanceSupplier @relation(fields: [supplierId, facilityId], references: [id, facilityId], onUpdate: NoAction)
  bill         FinanceBill?

  @@unique([id, facilityId])
  @@unique([facilityId, sourceSystem, grnReference])
  @@map("finance_procurement_receipt")
  app_user     AppUser         @relation(fields: [createdBy, facilityId], references: [id, facilityId], onUpdate: NoAction)
}

model FinanceStatement {
  id             String                 @id @default(uuid())
  facilityId     String                 @map("facility_id")
  accountId      String                 @map("account_id")
  reference      String
  startsOn       DateTime               @map("starts_on") @db.Timestamptz(3)
  endsOn         DateTime               @map("ends_on") @db.Timestamptz(3)
  openingBalance Decimal                @map("opening_balance") @db.Decimal(18, 2)
  closingBalance Decimal                @map("closing_balance") @db.Decimal(18, 2)
  reconciledAt   DateTime?              @map("reconciled_at") @db.Timestamptz(3)
  reconciledBy   String?                @map("reconciled_by")
  reconciler     AppUser?               @relation("StatementReconciler", fields: [reconciledBy, facilityId], references: [id, facilityId], onDelete: Restrict)
  facility       Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  account        FinanceAccount         @relation(fields: [accountId, facilityId], references: [id, facilityId], onDelete: Restrict)
  lines          FinanceStatementLine[]

  @@unique([facilityId, accountId, reference])
  @@unique([id, facilityId])
  @@map("finance_statement")
}

model FinanceStatementLine {
  id            String              @id @default(uuid())
  facilityId    String              @map("facility_id")
  statementId   String              @map("statement_id")
  date          DateTime            @db.Timestamptz(3)
  description   String
  amount        Decimal             @db.Decimal(18, 2)
  journalLineId String?             @unique @map("journal_line_id")
  statement     FinanceStatement    @relation(fields: [statementId, facilityId], references: [id, facilityId], onDelete: Restrict)
  journalLine   FinanceJournalLine? @relation(fields: [journalLineId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@unique([journalLineId, facilityId])
  @@map("finance_statement_line")
}

/// 2 — ONE department table with a type enum.
model Department {
  id           String         @id @default(uuid())
  facilityId   String         @map("facility_id")
  code         String
  name         String
  // Dari (prs) and Pashto (ps) local names — see Facility. Both optional.
  nameLocalPrs String?        @map("name_local_prs")
  nameLocalPs  String?        @map("name_local_ps")
  type         DepartmentType
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  facility            Facility                 @relation(fields: [facilityId], references: [id])
  rooms               Room[]
  services            Service[]
  visits              Visit[]
  appointments        Appointment[]
  staff               PractitionerDepartment[]
  employees           Employee[]
  rosterEntries       RosterEntry[]
  receptionBeds       ReceptionBed[]
  receptionRequests   ReceptionCareRequest[]
  appointmentWaitlist AppointmentWaitlist[]

  @@unique([facilityId, code])
  @@unique([id, facilityId])
  @@index([facilityId, type])
  @@map("department")
}

/// 3
model Room {
  id           String   @id @default(uuid())
  facilityId   String   @map("facility_id")
  departmentId String   @map("department_id")
  code         String
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  facility      Facility       @relation(fields: [facilityId], references: [id])
  department    Department     @relation(fields: [departmentId, facilityId], references: [id, facilityId], onDelete: Restrict)
  visits        Visit[]
  receptionBeds ReceptionBed[]

  @@unique([facilityId, code])
  @@unique([id, facilityId])
  @@map("room")
}

// ============================================================
// 2. IDENTITY, AUTH & RBAC
// ============================================================

/// 4
model AppUser {
  ownedCrmTasks               CrmTask[]                @relation("CrmTaskOwner")
  crmTaskHistory              CrmTaskHistory[]         @relation("CrmTaskActor")
  crmTaskAssignments          CrmTaskHistory[]         @relation("CrmTaskHistoryOwner")
  completedCrmCalls           CrmCall[]
  crmInteractions             CrmInteraction[]         @relation("CrmInteractionAuthor")
  crmInteractionRevisions     CrmInteractionRevision[]
  ownedCrmLeads               CrmLead[]                @relation("CrmLeadOwner")
  crmLeadChanges              CrmLeadStatusChange[]
  reportGrants                FinanceReportGrant[]     @relation("ReportViewer")
  createdFinanceJournals      FinanceJournal[]         @relation("JournalCreator")
  postedFinanceJournals       FinanceJournal[]         @relation("JournalPoster")
  closedFiscalPeriods         FiscalPeriod[]           @relation("FiscalPeriodCloser")
  closedLegacyPeriods         FinanceLegacyPeriod[]    @relation("LegacyPeriodCloser")
  reconciledFinanceStatements FinanceStatement[]       @relation("StatementReconciler")
  id                          String                   @id @default(uuid())
  facilityId                  String                   @map("facility_id")
  username                    String
  email                       String?
  passwordHash                String                   @map("password_hash")
  mustChangePassword          Boolean                  @default(false) @map("must_change_password")
  credentialVersion           Int                      @default(0) @map("credential_version")
  fullName                    String                   @map("full_name")
  isActive                    Boolean                  @default(true) @map("is_active")
  lastLoginAt                 DateTime?                @map("last_login_at")
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @updatedAt @map("updated_at")
  deletedAt                   DateTime?                @map("deleted_at")

  facility          Facility           @relation(fields: [facilityId], references: [id])
  practitioner      Practitioner?
  userRoles         UserRole[]
  sessions          Session[]
  auditLogs         AuditLog[]
  errorLogs         ErrorLog[]
  followUpResponses FollowUpResponse[]
  employee          Employee?
  hrNotifications   HrNotification[]

  @@unique([facilityId, username])
  @@unique([id, facilityId])
  @@map("app_user")
  crm_lead_patient_crm_lead_patient_created_by_facility_idToapp_user           CrmLeadPatient[]            @relation("crm_lead_patient_created_by_facility_idToapp_user")
  crm_lead_patient_crm_lead_patient_revoked_by_facility_idToapp_user           CrmLeadPatient[]            @relation("crm_lead_patient_revoked_by_facility_idToapp_user")
  finance_asset                                                                FinanceAsset[]
  finance_period_finance_period_locked_by_facility_idToapp_user                FiscalPeriod[]              @relation("finance_period_locked_by_facility_idToapp_user")
  finance_period_event                                                         FinancePeriodEvent[]
  finance_procurement_receipt                                                  FinanceProcurementReceipt[]
  finance_report_grant_finance_report_grant_granted_by_facility_idToapp_user   FinanceReportGrant[]        @relation("finance_report_grant_granted_by_facility_idToapp_user")
  finance_till_close_finance_till_close_approved_by_facility_idToapp_user      FinanceTillClose[]          @relation("finance_till_close_approved_by_facility_idToapp_user")
  finance_till_close_finance_till_close_created_by_facility_idToapp_user       FinanceTillClose[]          @relation("finance_till_close_created_by_facility_idToapp_user")
  finance_till_close_finance_till_close_user_id_facility_idToapp_user          FinanceTillClose[]          @relation("finance_till_close_user_id_facility_idToapp_user")
  finance_year_closing_finance_year_closing_finalized_by_facility_idToapp_user FinanceYearClosing[]        @relation("finance_year_closing_finalized_by_facility_idToapp_user")
  finance_year_closing_finance_year_closing_prepared_by_facility_idToapp_user  FinanceYearClosing[]        @relation("finance_year_closing_prepared_by_facility_idToapp_user")
  payroll_run_payroll_run_approved_by_facility_idToapp_user                    PayrollRun[]                @relation("payroll_run_approved_by_facility_idToapp_user")
  payroll_run_payroll_run_created_by_facility_idToapp_user                     PayrollRun[]                @relation("payroll_run_created_by_facility_idToapp_user")
  payroll_run_payroll_run_reviewed_by_facility_idToapp_user                    PayrollRun[]                @relation("payroll_run_reviewed_by_facility_idToapp_user")
}

/// 5 — admin, receptionist, nurse, doctor, lab_tech, pharmacist, management.
/// Seeded from roles-and-permissions.md (task 1.2), which is the source of
/// truth. There is no `cashier`: the hospital confirmed the receptionist is
/// also the cashier, so the two are one role.
model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

/// 6 — "patient.create", "prescription.write", "lab.result.enter"
model Permission {
  id       String @id @default(uuid())
  code     String @unique
  resource String
  action   String

  rolePermissions RolePermission[]

  @@map("permission")
}

/// 7 — the matrix itself. A row here is a grant; no row is a denial.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  /// The rule from roles-and-permissions.md that CONSTRAINS this grant —
  /// "R5", "R10", "R2". NULL means unconditional (✅ in the matrix); a value
  /// means ⚠️: allowed, but only within the rule.
  ///
  /// This column exists because without it the matrix cannot be stored. A
  /// receptionist's `discount.apply ⚠️ R10` (10% ceiling) and an admin's
  /// unconditional `invoice.void` would be identical rows, and the DB would
  /// answer "what can a receptionist do?" by over-reporting her authority.
  ///
  /// It is a plain string, not an enum, because the rules live in a document
  /// the hospital revises. An enum would mean a migration every time a rule is
  /// renamed, and the guard has to fail closed on an unrecognised code anyway.
  condition String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

/// 8
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

/// 9
model Session {
  id               String               @id @default(uuid())
  userId           String               @map("user_id")
  // Unique: each session's refresh token is distinct, and refresh looks a session
  // up BY this hash on every renewal — so it must be indexed, and a collision
  // would be a two-sessions-one-token bug we want the DB to reject. (task 1.8)
  refreshTokenHash String               @unique @map("refresh_token_hash")
  ipAddress        String?              @map("ip_address")
  userAgent        String?              @map("user_agent")
  expiresAt        DateTime             @map("expires_at")
  revokedAt        DateTime?            @map("revoked_at")
  revokedReason    SessionRevokeReason? @map("revoked_reason")
  createdAt        DateTime             @default(now()) @map("created_at")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// 10 — written by a NestJS interceptor on every mutating request. Append-only.
model AuditLog {
  id         String      @id @default(uuid())
  facilityId String      @map("facility_id")
  userId     String?     @map("user_id")
  action     AuditAction
  entity     String
  entityId   String?     @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  facility Facility @relation(fields: [facilityId], references: [id])
  user     AppUser? @relation(fields: [userId], references: [id])

  @@index([facilityId, entity, entityId])
  @@index([facilityId, createdAt])
  @@map("audit_log")
}

/// 7.8 — every 5xx the app throws, written by AllExceptionsFilter. Append-only, and the
/// reason "you can debug a 2am call" is answerable from a browser instead of a terminal:
/// this table plus the admin-only Errors tab (reports module) is the whole feature.
/// facilityId/userId are NULLABLE, unlike AuditLog's — a malformed request can fail before
/// auth ever resolves who or which facility this was (a broken /auth/login body, a probe
/// hitting a public route), and that failure still needs to be visible.
model ErrorLog {
  id         String   @id @default(uuid())
  facilityId String?  @map("facility_id")
  userId     String?  @map("user_id")
  method     String
  path       String
  statusCode Int      @map("status_code")
  message    String
  /// The full stack — this table IS the detail view a stack trace usually needs a
  /// terminal to see. Not shown to the caller (AllExceptionsFilter already keeps that
  /// wall); only to whoever holds `error_log.read`.
  stack      String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  facility Facility? @relation(fields: [facilityId], references: [id])
  user     AppUser?  @relation(fields: [userId], references: [id])

  @@index([facilityId, createdAt])
  @@map("error_log")
}

// ============================================================
// 3. PRACTITIONERS
// ============================================================

/// 11
model Speciality {
  id   String @id @default(uuid())
  code String @unique
  name String

  practitioners Practitioner[]

  @@map("speciality")
}

/// 12 — FHIR Practitioner. Linked 1:1 to AppUser when they log in.
/// NOTE: no departmentId. A doctor works across departments — see PractitionerDepartment.
model Practitioner {
  id           String    @id @default(uuid())
  facilityId   String    @map("facility_id")
  userId       String?   @unique @map("user_id")
  specialityId String?   @map("speciality_id")
  code         String
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  licenseNo    String?   @map("license_no")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  facility            Facility                 @relation(fields: [facilityId], references: [id])
  user                AppUser?                 @relation(fields: [userId, facilityId], references: [id, facilityId], onDelete: Restrict)
  speciality          Speciality?              @relation(fields: [specialityId], references: [id])
  departments         PractitionerDepartment[]
  visits              Visit[]
  appointments        Appointment[]
  prescriptions       Prescription[]
  labOrders           LabOrder[]
  diagnoses           Diagnosis[]
  clinicalNotes       ClinicalNote[]
  appointmentWaitlist AppointmentWaitlist[]

  @@unique([facilityId, code])
  @@unique([id, facilityId])
  @@unique([userId, facilityId])
  @@map("practitioner")
}

/// 13 — Shamo's catch. A doctor does OPD Monday and IPD Wednesday.
/// Which hat he wore on a given day lives on Visit.departmentId.
model PractitionerDepartment {
  practitionerId String @map("practitioner_id")
  departmentId   String @map("department_id")

  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([practitionerId, departmentId])
  @@map("practitioner_department")
}

// ============================================================
// 4. PATIENT
// ============================================================

/// 14 — dateOfBirth, NOT age. Age is derived.
model Patient {
  crmRelationships CrmRelationship[]
  id               String            @id @default(uuid())
  facilityId       String            @map("facility_id")
  mrn              String // human-facing medical record number
  prefix           String? // Mr. / Mrs. / Dr.
  firstName        String            @map("first_name")
  lastName         String?           @map("last_name")
  dateOfBirth      DateTime?         @map("date_of_birth") @db.Date

  /// DOB is often genuinely unknown here. When it is, record the ESTIMATE —
  /// years+months+days, because "1 year old" is useless for an infant.
  /// Straight off the Medi-Pro form. Never store a computed age.
  estimatedAgeYears  Int?      @map("estimated_age_years")
  estimatedAgeMonths Int?      @map("estimated_age_months")
  estimatedAgeDays   Int?      @map("estimated_age_days")
  ageRecordedAt      DateTime? @map("age_recorded_at") @db.Date // anchor for the estimate

  gender           Gender
  guardianName     String?           @map("guardian_name")
  guardianRelation GuardianRelation? @map("guardian_relation") // S/o, D/o, W/o
  phone            String?
  altPhone         String?           @map("alt_phone")
  address          String?
  district         String?
  province         String?
  nationalId       String?           @map("national_id") // tazkira
  passportNo       String?           @map("passport_no")
  occupation       String?
  nationality      String?
  bloodGroup       String?           @map("blood_group")
  isDeceased       Boolean           @default(false) @map("is_deceased")
  deceasedDate     DateTime?         @map("deceased_date")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  createdBy        String?           @map("created_by")

  facility              Facility                  @relation(fields: [facilityId], references: [id])
  identifiers           PatientIdentifier[]
  allergies             Allergy[]
  visits                Visit[]
  appointments          Appointment[]
  invoices              Invoice[]
  receptionRequests     ReceptionCareRequest[]    @relation("ReceptionRequestPatient")
  receptionMergeTargets ReceptionCareRequest[]    @relation("ReceptionRequestTargetPatient")
  appointmentWaitlist   AppointmentWaitlist[]
  receptionDocuments    PatientDocument[]
  receptionContacts     PatientContact[]
  receptionCoverages    PatientCoverage[]
  receptionDeposits     ReceptionPatientDeposit[]
  receptionReminders    ReceptionReminder[]

  @@unique([facilityId, mrn])
  @@unique([id, facilityId])
  @@index([facilityId, phone])
  @@index([facilityId, lastName, firstName])
  @@map("patient")
}

/// 15 — the same human has: your MRN, an old Medi-Pro patient no, a tazkira
/// number, an insurance/panel number, an AXON number. One table, not a column each.
/// THIS IS HOW YOU MIGRATE THE OLD MEDI-PRO DATA — keep the legacy number.
model PatientIdentifier {
  id        String   @id @default(uuid())
  patientId String   @map("patient_id")
  system    String // "medipro_legacy", "tazkira", "moph", "panel_x"
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([system, value])
  @@index([patientId])
  @@map("patient_identifier")
}

/// 16 — safety table. Checked at prescribing time.
/// substance is free text + autocomplete; drugId set only if it's a formulary drug.
model Allergy {
  id        String          @id @default(uuid())
  patientId String          @map("patient_id")
  drugId    String?         @map("drug_id")
  substance String
  reaction  String?
  severity  AllergySeverity
  notedAt   DateTime        @default(now()) @map("noted_at")
  notedBy   String?         @map("noted_by")
  isActive  Boolean         @default(true) @map("is_active")

  patient Patient @relation(fields: [patientId], references: [id])
  drug    Drug?   @relation(fields: [drugId], references: [id])

  @@index([patientId])
  @@map("allergy")
}

// ============================================================
// 5. APPOINTMENT & VISIT — the spine
// ============================================================

/// 17 — the PLAN. Optional. Separate from what actually happened.
model Appointment {
  endsAt         DateTime?         @map("ends_at")
  crmLinkId      String?           @map("crm_link_id")
  crmLeadId      String?           @map("crm_lead_id")
  crmLink            CrmRelationship?       @relation(fields: [crmLinkId, patientId, facilityId], references: [id, patientId, facilityId], map: "appointment_crm_link_fkey")
  crmLead            CrmLead?               @relation(fields: [crmLeadId, facilityId], references: [id, facilityId], map: "appointment_crm_lead_fkey")
  id             String            @id @default(uuid())
  facilityId     String            @map("facility_id")
  patientId      String            @map("patient_id")
  practitionerId String?           @map("practitioner_id")
  departmentId   String            @map("department_id")
  scheduledAt    DateTime          @map("scheduled_at")
  status         AppointmentStatus @default(booked)
  reason         String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  createdBy      String?           @map("created_by")

  facility           Facility               @relation(fields: [facilityId], references: [id])
  patient            Patient                @relation(fields: [patientId, facilityId], references: [id, facilityId], onDelete: Restrict)
  practitioner       Practitioner?          @relation(fields: [practitionerId, facilityId], references: [id, facilityId], onDelete: Restrict)
  department         Department             @relation(fields: [departmentId, facilityId], references: [id, facilityId], onDelete: Restrict)
  visit              Visit?
  receptionRequests  ReceptionCareRequest[]
  waitlistEntries    AppointmentWaitlist[]
  receptionReminders ReceptionReminder[]

  @@unique([id, facilityId])
  @@index([facilityId, scheduledAt])
  @@index([patientId])
  @@map("appointment")
}

/// 18 — THE SPINE. FHIR Encounter.
/// Every clinical record points HERE, never straight at the patient.
model Visit {
  id             String      @id @default(uuid())
  facilityId     String      @map("facility_id")
  patientId      String      @map("patient_id")
  appointmentId  String?     @unique @map("appointment_id")
  departmentId   String      @map("department_id")
  practitionerId String?     @map("practitioner_id") // null for walk-in lab
  roomId         String?     @map("room_id")
  visitNo        String      @map("visit_no") // OPD-2026-04671
  type           VisitType
  status         VisitStatus @default(arrived)

  /// Free text. "oliguria, frequency, nocturia" — exactly as the old system does it.
  /// The separate Complaint table was over-modeling. Shamo was right to kill it.
  chiefComplaint String? @map("chief_complaint")

  /// Referral tracking — off the Medi-Pro form. This is marketing data:
  /// which outside doctor sends you patients.
  referredBy     String? @map("referred_by")
  referralSource String? @map("referral_source")

  startedAt               DateTime  @default(now()) @map("started_at")
  endedAt                 DateTime? @map("ended_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdBy               String?   @map("created_by")
  queuePriority           Int       @default(0) @map("queue_priority")
  queuePriorityReason     String?   @map("queue_priority_reason")
  queuePriorityApprovedBy String?   @map("queue_priority_approved_by")
  queuePriorityApprovedAt DateTime? @map("queue_priority_approved_at") @db.Timestamptz(3)

  facility          Facility               @relation(fields: [facilityId], references: [id])
  patient           Patient                @relation(fields: [patientId, facilityId], references: [id, facilityId], onDelete: Restrict)
  appointment       Appointment?           @relation(fields: [appointmentId], references: [id])
  department        Department             @relation(fields: [departmentId, facilityId], references: [id, facilityId], onDelete: Restrict)
  practitioner      Practitioner?          @relation(fields: [practitionerId, facilityId], references: [id, facilityId], onDelete: Restrict)
  room              Room?                  @relation(fields: [roomId, facilityId], references: [id, facilityId], onDelete: Restrict)
  statusHistory     VisitStatusHistory[]
  vitals            Vitals[]
  diagnoses         Diagnosis[]
  clinicalNotes     ClinicalNote[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  attachments       Attachment[]
  invoices          Invoice[]
  receptionRequests ReceptionCareRequest[]

  @@unique([facilityId, visitNo])
  @@unique([id, facilityId])
  /// THIS INDEX IS THE DOCTOR'S QUEUE.
  @@index([facilityId, departmentId, status, startedAt])
  /// And this one is the same queue asked the other way (task 3.7). A doctor opens
  /// "my patients today"; the desk and the nurses open "the OPD queue". Same screen,
  /// different leading column, and neither query can use the other's index — the
  /// filter that is not leading would degrade to a scan of the whole department.
  @@index([facilityId, practitionerId, status, startedAt])
  @@index([patientId, startedAt])
  @@map("visit")
}

/// Reception-side coordination only. Clinical admission, transfer, discharge and
/// queue-priority decisions stay pending until an authorised reviewer approves them.
model ReceptionCareRequest {
  id              String    @id @default(uuid())
  facilityId      String    @map("facility_id")
  reference       String
  kind            String
  patientId       String    @map("patient_id")
  targetPatientId String?   @map("target_patient_id")
  visitId         String?   @map("visit_id")
  appointmentId   String?   @map("appointment_id")
  departmentId    String?   @map("department_id")
  sourceBedId     String?   @map("source_bed_id")
  targetBedId     String?   @map("target_bed_id")
  priority        String    @default("routine")
  status          String    @default("pending")
  reason          String
  notes           String    @default("")
  requestedBy     String    @map("requested_by")
  requestedAt     DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewNote      String    @default("") @map("review_note")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  facility      Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient       Patient       @relation("ReceptionRequestPatient", fields: [patientId, facilityId], references: [id, facilityId], onDelete: Restrict)
  targetPatient Patient?      @relation("ReceptionRequestTargetPatient", fields: [targetPatientId, facilityId], references: [id, facilityId], onDelete: Restrict)
  department    Department?   @relation(fields: [departmentId, facilityId], references: [id, facilityId], onDelete: Restrict)
  sourceBed     ReceptionBed? @relation("ReceptionRequestSourceBed", fields: [sourceBedId, facilityId], references: [id, facilityId], onDelete: Restrict)
  targetBed     ReceptionBed? @relation("ReceptionRequestTargetBed", fields: [targetBedId, facilityId], references: [id, facilityId], onDelete: Restrict)
  visit         Visit?        @relation(fields: [visitId, facilityId], references: [id, facilityId], onDelete: Restrict)
  appointment   Appointment?  @relation(fields: [appointmentId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@unique([facilityId, reference])
  @@unique([id, facilityId])
  @@index([facilityId, status, requestedAt])
  @@index([patientId, requestedAt])
  @@map("reception_care_request")
}

model ReceptionBed {
