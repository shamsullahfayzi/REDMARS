  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String               @map("updated_by")
  voidedAt   DateTime?            @map("voided_at") @db.Timestamptz(3)
  voidedBy   String?              @map("voided_by")
  voidReason String?              @map("void_reason")

  facility         Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  employee         Employee       @relation(fields: [employeeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  credentials      Credential[]
  leaveAttachments LeaveRequest[] @relation("LeaveAttachment")

  @@unique([id, facilityId])
  @@index([facilityId, employeeId, type])
  @@map("employee_document")
}

model Credential {
  id                 String         @id @default(uuid())
  facilityId         String         @map("facility_id")
  employeeId         String         @map("employee_id")
  type               CredentialType
  name               String
  issuingAuthority   String?        @map("issuing_authority")
  referenceNo        String?        @map("reference_no")
  issuedOn           DateTime?      @map("issued_on") @db.Date
  expiresOn          DateTime?      @map("expires_on") @db.Date
  blocksClinicalWork Boolean        @default(false) @map("blocks_clinical_work")
  documentId         String?        @map("document_id")
  note               String?
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String         @map("created_by")
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String         @map("updated_by")
  voidedAt           DateTime?      @map("voided_at") @db.Timestamptz(3)
  voidedBy           String?        @map("voided_by")
  voidReason         String?        @map("void_reason")

  facility  Facility             @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  employee  Employee             @relation(fields: [employeeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  document  EmployeeDocument?    @relation(fields: [documentId, facilityId], references: [id, facilityId], onDelete: Restrict)
  reminders CredentialReminder[]

  @@unique([id, facilityId])
  @@index([facilityId, expiresOn])
  @@map("employee_credential")
}

model CredentialReminder {
  id           String   @id @default(uuid())
  facilityId   String   @map("facility_id")
  credentialId String   @map("credential_id")
  threshold    Int
  sentAt       DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)
  recipients   Json

  facility   Facility   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  credential Credential @relation(fields: [credentialId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@unique([credentialId, threshold])
  @@index([facilityId, sentAt])
  @@map("credential_reminder")
}

model ShiftType {
  id              String    @id @default(uuid())
  facilityId      String    @map("facility_id")
  code            String
  nameEn          String    @map("name_en")
  namePrs         String?   @map("name_prs")
  namePs          String?   @map("name_ps")
  startsAt        DateTime  @map("starts_at") @db.Time(0)
  endsAt          DateTime  @map("ends_at") @db.Time(0)
  crossesMidnight Boolean   @default(false) @map("crosses_midnight")
  color           String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by")
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String    @map("updated_by")
  voidedAt        DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy        String?   @map("voided_by")
  voidReason      String?   @map("void_reason")

  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  attendanceDays AttendanceDay[]
  rosterEntries  RosterEntry[]

  @@unique([facilityId, code])
  @@unique([id, facilityId])
  @@index([facilityId, isActive])
  @@map("shift_type")
}

model AttendanceDay {
  id             String           @id @default(uuid())
  facilityId     String           @map("facility_id")
  employeeId     String           @map("employee_id")
  workDate       DateTime         @map("work_date") @db.Date
  shiftTypeId    String?          @map("shift_type_id")
  status         AttendanceStatus
  minutesLate    Int              @default(0) @map("minutes_late")
  note           String?
  leaveRequestId String?          @map("leave_request_id")
  markedByUserId String           @map("marked_by_user_id")
  markedAt       DateTime         @default(now()) @map("marked_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String           @map("created_by")
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String           @map("updated_by")
  voidedAt       DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidedBy       String?          @map("voided_by")
  voidReason     String?          @map("void_reason")

  facility     Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  employee     Employee      @relation(fields: [employeeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  shiftType    ShiftType?    @relation(fields: [shiftTypeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@unique([id, facilityId])
  @@index([facilityId, workDate, employeeId])
  @@map("attendance_day")
}

model LeaveType {
  id                 String    @id @default(uuid())
  facilityId         String    @map("facility_id")
  code               String
  nameEn             String    @map("name_en")
  namePrs            String?   @map("name_prs")
  namePs             String?   @map("name_ps")
  annualEntitlement  Int?      @map("annual_entitlement")
  requiresAttachment Boolean   @default(false) @map("requires_attachment")
  isPaid             Boolean   @default(true) @map("is_paid")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String    @map("created_by")
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String    @map("updated_by")
  voidedAt           DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy           String?   @map("voided_by")
  voidReason         String?   @map("void_reason")

  facility      Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  leaveRequests LeaveRequest[]

  @@unique([facilityId, code])
  @@unique([id, facilityId])
  @@index([facilityId, isActive])
  @@map("leave_type")
}

model LeaveRequest {
  id                   String             @id @default(uuid())
  facilityId           String             @map("facility_id")
  employeeId           String             @map("employee_id")
  leaveTypeId          String             @map("leave_type_id")
  startsOn             DateTime           @map("starts_on") @db.Date
  endsOn               DateTime           @map("ends_on") @db.Date
  daysRequested        Int                @map("days_requested")
  reason               String?
  status               LeaveRequestStatus @default(submitted)
  attachmentDocumentId String?            @map("attachment_document_id")
  decidedBy            String?            @map("decided_by")
  decidedAt            DateTime?          @map("decided_at") @db.Timestamptz(3)
  decisionNote         String?            @map("decision_note")
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy            String             @map("created_by")
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy            String             @map("updated_by")
  voidedAt             DateTime?          @map("voided_at") @db.Timestamptz(3)
  voidedBy             String?            @map("voided_by")
  voidReason           String?            @map("void_reason")

  facility           Facility          @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  employee           Employee          @relation(fields: [employeeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  leaveType          LeaveType         @relation(fields: [leaveTypeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  attachmentDocument EmployeeDocument? @relation("LeaveAttachment", fields: [attachmentDocumentId, facilityId], references: [id, facilityId], onDelete: Restrict)
  attendanceDays     AttendanceDay[]

  @@unique([id, facilityId])
  @@index([facilityId, employeeId, startsOn, endsOn])
  @@index([facilityId, status])
  @@map("leave_request")
}

model HrHoliday {
  id          String   @id @default(uuid())
  facilityId  String   @map("facility_id")
  holidayDate DateTime @map("holiday_date") @db.Date
  nameEn      String   @map("name_en")
  namePrs     String?  @map("name_prs")
  namePs      String?  @map("name_ps")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String   @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String   @map("updated_by")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([facilityId, holidayDate])
  @@map("hr_holiday")
}

model RosterEntry {
  id            String       @id @default(uuid())
  facilityId    String       @map("facility_id")
  employeeId    String       @map("employee_id")
  departmentId  String       @map("department_id")
  shiftTypeId   String       @map("shift_type_id")
  dutyDate      DateTime     @map("duty_date") @db.Date
  roleOnShift   String?      @map("role_on_shift")
  status        RosterStatus @default(draft)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(3)
  publishedBy   String?      @map("published_by")
  swappedFromId String?      @map("swapped_from_id")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String       @map("created_by")
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy     String       @map("updated_by")
  voidedAt      DateTime?    @map("voided_at") @db.Timestamptz(3)
  voidedBy      String?      @map("voided_by")
  voidReason    String?      @map("void_reason")

  facility    Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  employee    Employee      @relation(fields: [employeeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  department  Department    @relation(fields: [departmentId, facilityId], references: [id, facilityId], onDelete: Restrict)
  shiftType   ShiftType     @relation(fields: [shiftTypeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  swappedFrom RosterEntry?  @relation("RosterSwap", fields: [swappedFromId, facilityId], references: [id, facilityId], onDelete: Restrict)
  swaps       RosterEntry[] @relation("RosterSwap")

  @@unique([facilityId, employeeId, dutyDate, shiftTypeId])
  @@unique([id, facilityId])
  @@index([facilityId, departmentId, dutyDate, status])
  @@map("roster_entry")
}

model HrNotification {
  id              String    @id @default(uuid())
  facilityId      String    @map("facility_id")
  employeeId      String?   @map("employee_id")
  recipientUserId String?   @map("recipient_user_id")
  type            String
  title           String
  message         String
  payload         Json?
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  facility      Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  employee      Employee? @relation(fields: [employeeId, facilityId], references: [id, facilityId], onDelete: Restrict)
  recipientUser AppUser?  @relation(fields: [recipientUserId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@index([facilityId, recipientUserId, readAt])
  @@map("hr_notification")
}
