  facility    Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  patient     Patient         @relation(fields: [patientId, facilityId], references: [id, facilityId], onDelete: Restrict)
  appointment Appointment?    @relation(fields: [appointmentId, facilityId], references: [id, facilityId], onDelete: Restrict)
  contact     PatientContact? @relation(fields: [contactId, facilityId], references: [id, facilityId], onDelete: Restrict)

  @@unique([id, facilityId])
  @@index([facilityId, status, scheduledFor])
