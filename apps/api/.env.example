# apps/api runtime env template. COMMITTED. Copy to apps/api/.env and fill in.
# Must match the DB defined in root .env / docker-compose.yml.
DATABASE_URL="postgresql://redmars:change-me@localhost:5433/redmars?schema=public"

# Exact origin allowed to call this API from a browser. Never '*'.
CORS_ORIGIN="http://localhost:5173"

# --- Seed (pnpm seed) ---
# Optional. If SEED_ADMIN_PASSWORD is unset the seed generates a strong random
# password and prints it once — it is never stored in plaintext. There is no
# default password by design (task 7.3).
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD=""
