# apps/api runtime env template. COMMITTED. Copy to apps/api/.env and fill in.
# Must match the DB defined in root .env / docker-compose.yml.
DATABASE_URL="postgresql://redmars:change-me@localhost:5433/redmars?schema=public"

# Exact origin allowed to call this API from a browser. Never '*'.
CORS_ORIGIN="http://localhost:5173"

# --- Auth (1.1) ---
# REQUIRED. No default exists: a shipped default secret would let anyone holding
# this source forge an admin token against any hospital's deployment.
# Generate a fresh one per install:
#   openssl rand -base64 48
JWT_SECRET=""

# Access token lifetime in seconds. Access tokens are not revocable, so this
# value IS the revocation window — how long a stolen token outlives a disabled
# account. 900 = 15 minutes.
JWT_ACCESS_TTL_SECONDS=900

# Refresh token lifetime in days. Revocable (Session row), so it can be longer.
JWT_REFRESH_TTL_DAYS=7

# --- Seed (pnpm seed) ---
# Optional. If SEED_ADMIN_PASSWORD is unset the seed generates a strong random
# password and prints it once — it is never stored in plaintext. There is no
# default password by design (task 7.3).
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_PASSWORD=""
