{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    /* The CommonJS half of a dual build. apps/api is a CJS NestJS build and
       throws "require() of an ES Module" on ESM, so it eats this one.
       tsconfig.esm.json emits the same source as real ESM for apps/web —
       see the note there for why one format cannot serve both. */
    "module": "commonjs",
    "moduleResolution": "node",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/cjs",
    "rootDir": "./src",

    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
