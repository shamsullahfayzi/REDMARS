# WSL2 Docker builds hit registry fetch timeouts on some hosts (network stack
# flakiness — MTU/DNS, not bandwidth: "[23] operation aborted due to timeout").
# Longer timeout + retries + lower concurrency ride it out instead of failing
# the whole `pnpm install --frozen-lockfile` on one dropped connection.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
network-concurrency=4
