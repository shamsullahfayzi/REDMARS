# Optional S3-compatible restic repository. Replace every REPLACE value.
# Install as /etc/redmars-testing/offsite.env with mode 600.
OFFSITE_ENABLED=true
RESTIC_REPOSITORY=s3:https://REPLACE-S3-ENDPOINT/REPLACE-BUCKET
RESTIC_PASSWORD_FILE=/root/redmars-restic-password
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
AWS_DEFAULT_REGION=REPLACE
